<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_overworld_repeat"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <!-- Tema claro/escuro (disponível antes mesmo de criar a wallet) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_theme_light_setup"
            style="@style/Gameboy.Button"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="0dp"
            android:layout_marginEnd="4dp"
            android:text="☀"
            android:textSize="14sp"
            app:backgroundTint="@color/accent_yellow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_theme_dark_setup"
            style="@style/Gameboy.Button.Outline"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="0dp"
            android:text="🌙"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="⚡"
        android:textSize="40sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="POKéWALLET"
        android:textSize="20sp"
        style="@style/Gameboy.Title"
        android:textColor="@color/primary_red" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Bitcoin · Autocustódia"
        android:textSize="13sp"
        android:textColor="@color/gb_border_soft" />

    <!-- Caixa de boas-vindas estilo Game Boy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:background="@drawable/bg_gameboy_box"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comece sua jornada soberana."
            android:textSize="15sp"
            style="@style/Gameboy.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Crie ou restaure uma wallet Bitcoin sem custódia."
            android:textSize="14sp"
            android:textColor="@color/gb_border_soft" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circle_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="MAINNET"
                android:textSize="11sp"
                style="@style/Gameboy.Label"
                android:textColor="@color/green_status" />

        </LinearLayout>

    </LinearLayout>

    <!-- Botões -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_create_wallet"
        style="@style/Gameboy.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="@string/new_journey"
        android:textSize="13sp"
        app:backgroundTint="@color/accent_yellow" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_restore_wallet"
        style="@style/Gameboy.Button.Outline"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/restore_wallet"
        android:textSize="12sp" />

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progress_setup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:indeterminateTint="@color/accent_yellow"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_setup_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Gerando sua wallet…"
        android:textSize="13sp"
        android:textColor="@color/gb_border_soft"
        android:visibility="gone" />

    <!-- Erro -->
    <LinearLayout
        android:id="@+id/card_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:background="@drawable/bg_gameboy_button_outline">

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textSize="13sp"
            android:textColor="@color/error_red" />

    </LinearLayout>

    <!-- Aviso de soberania -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/sovereignty_warning"
        android:textSize="12sp"
        android:textColor="@color/gb_border_soft"
        android:gravity="center"
        android:alpha="0.85" />

</LinearLayout>
