<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gb_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gameboy_box"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛡 VERIFICAÇÃO"
            android:textSize="13sp"
            style="@style/Gameboy.Title"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prove que você anotou suas palavras.\nSem isso, sua wallet não ficará acessível."
            android:textSize="13sp"
            android:textColor="@color/gb_border_soft"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Palavra 1 -->
        <TextView
            android:id="@+id/tv_word1_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qual é a palavra #4?"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/gb_border"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="20dp"
            app:boxStrokeColor="@color/gb_border_soft"
            app:hintTextColor="@color/gb_border_soft">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_word1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/gb_border"
                android:textColorHint="@color/gb_border_soft"
                android:singleLine="true"
                android:fontFamily="monospace" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Palavra 2 -->
        <TextView
            android:id="@+id/tv_word2_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qual é a palavra #9?"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/gb_border"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="20dp"
            app:boxStrokeColor="@color/gb_border_soft"
            app:hintTextColor="@color/gb_border_soft">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_word2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/gb_border"
                android:textColorHint="@color/gb_border_soft"
                android:singleLine="true"
                android:fontFamily="monospace" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Passphrase (Pokémon ou personalizada — escondido se o modo for "sem passphrase") -->
        <LinearLayout
            android:id="@+id/group_verify_passphrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_pokemon_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Qual é o seu Pokémon?"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/gb_border"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ex: pokemon:125:Electabuzz"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="@color/gb_border_soft"
                app:hintTextColor="@color/gb_border_soft">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_pokemon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/gb_border"
                    android:textColorHint="@color/gb_border_soft"
                    android:singleLine="true"
                    android:fontFamily="monospace" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Erro -->
        <TextView
            android:id="@+id/tv_verify_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textSize="13sp"
            android:textColor="@color/error_red"
            android:gravity="center"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_verify_confirm"
            style="@style/Gameboy.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Confirmar e Acessar Wallet"
            android:textSize="11sp"
            app:backgroundTint="@color/green_status" />

    </LinearLayout>
</ScrollView>
