<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overworld_repeat">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gameboy_box"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧅 TOR (ORBOT)"
            android:textSize="13sp"
            style="@style/Gameboy.Title"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A wallet não embute Tor — precisa do app Orbot instalado e rodando neste aparelho, com o proxy SOCKS habilitado. Isso só é usado quando você escolhe o modo &quot;Tor&quot; na hora de enviar; consultas de saldo continuam normais."
            android:textSize="13sp"
            android:textColor="@color/gb_border_soft"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Host do proxy SOCKS (padrão 127.0.0.1)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp"
            app:boxStrokeColor="@color/gb_border_soft"
            app:hintTextColor="@color/gb_border_soft">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_tor_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri|textNoSuggestions"
                android:textColor="@color/gb_border"
                android:fontFamily="monospace"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Porta SOCKS (padrão 9050)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp"
            app:boxStrokeColor="@color/gb_border_soft"
            app:hintTextColor="@color/gb_border_soft">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_tor_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/gb_border"
                android:fontFamily="monospace"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_test_tor_connection"
            style="@style/Gameboy.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="🔌 Testar conexão"
            android:textSize="10sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_tor_test_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_tor_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/error_red"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_tor_config"
                style="@style/Gameboy.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Cancelar"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_tor_config"
                style="@style/Gameboy.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Salvar"
                android:textSize="12sp"
                app:backgroundTint="@color/accent_yellow" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
