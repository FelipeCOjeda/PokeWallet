<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gb_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gameboy_box"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗺 ENDEREÇOS"
            android:textSize="13sp"
            style="@style/Gameboy.Title"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <RadioGroup
            android:id="@+id/rg_address_chain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_chain_external"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/bitcoin_orange"
                android:textColor="@color/gb_border"
                android:checked="true"
                android:text="Recebimento" />

            <RadioButton
                android:id="@+id/rb_chain_internal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/bitcoin_orange"
                android:textColor="@color/gb_border"
                android:text="Troco" />

        </RadioGroup>

        <LinearLayout
            android:id="@+id/layout_address_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_address_list"
            style="@style/Gameboy.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Fechar"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
