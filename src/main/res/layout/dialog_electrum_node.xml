<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overworld_repeat">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gameboy_box"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌐 NODE ELECTRUM"
            android:textSize="13sp"
            style="@style/Gameboy.Title"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Opcional. Use um node próprio (ex: Floresta rodando na sua rede) pra consultar saldo/UTXOs e transmitir transações, em vez de Blockstream/mempool.space. Precisa estar na mesma rede Wi-Fi/LAN do node."
            android:textSize="13sp"
            android:textColor="@color/gb_border_soft"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="20dp" />

        <CheckBox
            android:id="@+id/cb_electrum_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Usar node próprio"
            android:textColor="@color/gb_border"
            android:textStyle="bold"
            android:buttonTint="@color/bitcoin_orange"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/group_electrum_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Host (ex: 192.168.3.169)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp"
                app:boxStrokeColor="@color/gb_border_soft"
                app:hintTextColor="@color/gb_border_soft">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_electrum_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri|textNoSuggestions"
                    android:textColor="@color/gb_border"
                    android:fontFamily="monospace"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Porta (padrão 50001)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp"
                app:boxStrokeColor="@color/gb_border_soft"
                app:hintTextColor="@color/gb_border_soft">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_electrum_port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/gb_border"
                    android:fontFamily="monospace"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/cb_electrum_tls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔒 Usar TLS/SSL"
                android:textColor="@color/gb_border"
                android:textStyle="bold"
                android:buttonTint="@color/bitcoin_orange"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_electrum_tls_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/error_red"
                android:lineSpacingExtra="2dp"
                android:text="⚠️ Sem TLS, os dados trafegam sem criptografia — use só na sua rede local (Wi-Fi de casa). Fora da LAN, ligue TLS ou não use node próprio."
                android:layout_marginBottom="12dp" />

            <CheckBox
                android:id="@+id/cb_electrum_cross_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔍 Cruzar saldo com API pública"
                android:textColor="@color/gb_border"
                android:textStyle="bold"
                android:buttonTint="@color/bitcoin_orange"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/gb_border_soft"
                android:lineSpacingExtra="2dp"
                android:text="Depois de cada varredura, confere o saldo dos endereços já conhecidos contra Blockstream/mempool.space e avisa se o node próprio reportar menos do que a API pública — defesa extra contra node comprometido escondendo fundos. Deixa o scan mais lento e volta a falar com a API pública (o oposto do motivo de usar node próprio), por isso é opcional."
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_test_electrum_connection"
                style="@style/Gameboy.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="🔌 Testar conexão"
                android:textSize="10sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_electrum_test_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Erro -->
        <TextView
            android:id="@+id/tv_electrum_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/error_red"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Botões -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_electrum_node"
                style="@style/Gameboy.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Cancelar"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_electrum_node"
                style="@style/Gameboy.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Salvar"
                android:textSize="12sp"
                app:backgroundTint="@color/accent_yellow" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
