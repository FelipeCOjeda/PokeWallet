<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overworld_repeat">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gameboy_box"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👁 IMPORTAR WATCH-ONLY"
            android:textSize="13sp"
            style="@style/Gameboy.Title"
            android:layout_marginBottom="20dp" />

        <!-- Aviso -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:cardBackgroundColor="#2A1A00"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text="⚠️  Essa carteira só vê saldo/endereços, sem poder assinar sozinha — pra enviar, você vai precisar de um segundo aparelho com a seed (assinatura air-gapped)."
                android:textSize="13sp"
                android:textColor="@color/bitcoin_orange"
                android:lineSpacingExtra="3dp" />

        </androidx.cardview.widget.CardView>

        <!-- Label chave pública -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHAVE PÚBLICA"
            android:textSize="10sp"
            style="@style/Gameboy.Label"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cole a xpub (ex: xpub6C…) ou a string completa exportada em “Ver Chave Pública” na carteira original ([fingerprint/caminho]xpub…). Confira se REDE e TIPO DE ENDEREÇO abaixo batem com a wallet original."
            android:textSize="12sp"
            android:textColor="@color/gb_border_soft"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="xpub6C… ou [a9fe848d/84'/0'/0']xpub…"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="28dp"
            app:boxStrokeColor="@color/gb_border_soft"
            app:hintTextColor="@color/gb_border_soft">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_account_origin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textNoSuggestions"
                android:textColor="@color/gb_border"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:minLines="3"
                android:gravity="top"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gb_border_soft"
            android:layout_marginBottom="28dp" />

        <!-- Label Rede -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REDE"
            android:textSize="10sp"
            style="@style/Gameboy.Label"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_network_watchonly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="28dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_watchonly_mainnet"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAINNET"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_watchonly_testnet"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TESTNET" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gb_border_soft"
            android:layout_marginBottom="28dp" />

        <!-- Label Tipo de endereço -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIPO DE ENDEREÇO"
            android:textSize="10sp"
            style="@style/Gameboy.Label"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Escolha o mesmo tipo que a wallet original usava."
            android:textSize="12sp"
            android:textColor="@color/gb_border_soft"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_address_type_watchonly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="28dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_watchonly_native_segwit"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Native SegWit"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_watchonly_taproot"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Taproot" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gb_border_soft"
            android:layout_marginBottom="28dp" />

        <!-- Label Nome da carteira -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOME DA CARTEIRA"
            android:textSize="10sp"
            style="@style/Gameboy.Label"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Opcional"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="24dp"
            app:boxStrokeColor="@color/gb_border_soft"
            app:hintTextColor="@color/gb_border_soft">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_wallet_name_watchonly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/gb_border"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Progresso -->
        <ProgressBar
            android:id="@+id/progress_watchonly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent_yellow"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Erro -->
        <TextView
            android:id="@+id/tv_watchonly_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/error_red"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Botões -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_watchonly"
                style="@style/Gameboy.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Cancelar"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_watchonly"
                style="@style/Gameboy.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Importar"
                android:textSize="12sp"
                app:backgroundTint="@color/accent_yellow" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
