<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overworld_repeat">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gameboy_box"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ RECEBER LIGHTNING"
            android:textSize="13sp"
            style="@style/Gameboy.Title"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Passo 1: escolher valor/descrição (BOLT11) ou pular direto pro
             endereço Spark (sem valor fixo, sem expiração). -->
        <LinearLayout
            android:id="@+id/group_lightning_receive_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Valor em sats (opcional)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="14dp"
                app:boxStrokeColor="@color/gb_border_soft"
                app:hintTextColor="@color/gb_border_soft">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_lightning_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/gb_border"
                    android:fontFamily="monospace"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Descrição (opcional)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="20dp"
                app:boxStrokeColor="@color/gb_border_soft"
                app:hintTextColor="@color/gb_border_soft">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_lightning_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/gb_border"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lightning_generate_invoice"
                style="@style/Gameboy.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="⚡ Gerar invoice"
                android:textSize="12sp"
                app:backgroundTint="@color/green_status"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lightning_use_spark"
                style="@style/Gameboy.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🔷 Usar endereço Spark (sem valor fixo)"
                android:textSize="11sp" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_lightning_receive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tv_lightning_receive_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/error_red"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="10dp" />

        <!-- Passo 2: resultado — QR + valor gerado, pronto pra compartilhar. -->
        <LinearLayout
            android:id="@+id/group_lightning_receive_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/img_lightning_qr"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginBottom="24dp"
                android:background="@android:color/white"
                android:padding="14dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tv_lightning_receive_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                style="@style/Gameboy.Label"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_lightning_receive_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textIsSelectable="true"
                android:textColor="@color/accent_yellow"
                android:background="@color/bg_dark"
                android:padding="18dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_lightning_receive"
                style="@style/Gameboy.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/copy"
                android:textSize="12sp"
                app:backgroundTint="@color/green_status"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lightning_receive_reset"
                style="@style/Gameboy.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="↩ Gerar outro"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
