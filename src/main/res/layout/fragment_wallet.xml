<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_overworld_repeat">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/gb_screen_alt"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/row_home_wallet_switcher"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_home_wallet_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="180dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="⚡ POKéWALLET"
                android:textSize="12sp"
                style="@style/Gameboy.Title"
                android:textColor="@color/primary_red" />

            <TextView
                android:id="@+id/tv_home_switch_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="🔽"
                android:textSize="9sp"
                android:textColor="@color/primary_red"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/badge_network"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/circle_green" />

            <TextView
                android:id="@+id/tv_network_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="MAINNET"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/green_status" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/gb_border" />

    <!-- Conteúdo scrollável -->
    <ScrollView
        android:id="@+id/scroll_base"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card de saldo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_gameboy_box"
                android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SALDO"
                        android:textSize="10sp"
                        style="@style/Gameboy.Label" />

                    <TextView
                        android:id="@+id/tv_balance_sats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="— sat"
                        android:textSize="22sp"
                        android:textColor="@color/gb_border"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_balance_btc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="— BTC"
                        android:textSize="14sp"
                        android:textColor="@color/gb_border_soft"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tv_balance_pending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/bitcoin_orange"
                        android:layout_marginTop="6dp"
                        android:visibility="gone" />

                    <!-- "SALDO" acima já é o TOTAL (on-chain + Lightning) —
                         esta linha só detalha quanto disso é Lightning,
                         pra não esconder que são dois saldos tecnicamente
                         separados (Spark é uma L2 à parte, ver Mochila).
                         Só aparece com Lightning conectado E saldo > 0. -->
                    <TextView
                        android:id="@+id/tv_balance_lightning_breakdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/accent_yellow"
                        android:layout_marginTop="6dp"
                        android:visibility="gone" />

                    <!-- Barra de progresso de scan -->
                    <ProgressBar
                        android:id="@+id/progress_scan"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="16dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/primary_red"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_scan_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="11sp"
                        android:textColor="@color/gb_border_soft"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_last_scan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="11sp"
                        android:textColor="@color/gb_border_soft"
                        android:visibility="gone" />

                    <!-- Erro na última verificação de saldo — antes disso, um scan que
                         falhasse (rede, timeout, etc.) ficava em silêncio total, saldo
                         parado no valor antigo sem nenhum aviso. -->
                    <TextView
                        android:id="@+id/tv_scan_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="11sp"
                        android:textColor="@color/error_red"
                        android:visibility="gone" />

                    <!-- Cross-check opcional (node Electrum → "Cruzar saldo com API
                         pública") achou divergência — possível node malicioso escondendo
                         fundos. Só aparece quando a opção está ligada E divergiu. -->
                    <TextView
                        android:id="@+id/tv_balance_cross_check_warning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="11sp"
                        android:textColor="@color/error_red"
                        android:visibility="gone" />

            </LinearLayout>

            <!-- Botões Receber / Enviar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_receive"
                    style="@style/Gameboy.Button"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="📥 Receber"
                    android:textSize="11sp"
                    app:backgroundTint="@color/green_status" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send"
                    style="@style/Gameboy.Button"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="💸 Enviar"
                    android:textSize="11sp"
                    app:backgroundTint="@color/bitcoin_orange" />

            </LinearLayout>

            <!-- Card Mochila -->
            <LinearLayout
                android:id="@+id/card_bag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                android:orientation="vertical"
                android:background="@drawable/bg_gameboy_box"
                android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎒 MOCHILA"
                        android:textSize="10sp"
                        style="@style/Gameboy.Label"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Pokébola: colorida = carteira com chave (seed), cinza =
                             watch-only (só xpub) — mesmo código de cores da tela de
                             trocar carteira. -->
                        <ImageView
                            android:id="@+id/img_wallet_type"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_pokeball"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tv_wallet_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="13sp"
                            android:textColor="@color/gb_border_soft" />

                        <TextView
                            android:id="@+id/btn_rename_wallet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✏️"
                            android:textSize="16sp"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="@color/gb_border_soft"
                        android:layout_marginVertical="12dp" />

                    <!-- Trocar/criar carteira -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗂 CARTEIRAS"
                        android:textSize="10sp"
                        style="@style/Gameboy.Label"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_switch_wallet"
                            style="@style/Gameboy.Button.Outline"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="🔄 Trocar"
                            android:textSize="10sp"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_new_wallet"
                            style="@style/Gameboy.Button.Outline"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="➕ Nova Carteira"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="@color/gb_border_soft"
                        android:layout_marginVertical="12dp" />

                    <!-- Endereços derivados -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗺 ENDEREÇOS"
                        android:textSize="10sp"
                        style="@style/Gameboy.Label"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_view_addresses"
                            style="@style/Gameboy.Button.Outline"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="📍 Endereços"
                            android:textSize="10sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_view_utxos"
                            style="@style/Gameboy.Button.Outline"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="🪙 UTXOs"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_public_key"
                        style="@style/Gameboy.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="12dp"
                        android:text="🔑 Ver Chave Pública"
                        android:textSize="10sp" />

                    <!-- Força uma varredura completa (índice 0 em diante) em vez da
                         incremental — usado quando um saldo não aparece mesmo com o
                         endereço certo (ex.: índice reservado ficou pra trás da
                         fronteira do scan incremental antes de receber fundos). -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_force_full_rescan"
                        style="@style/Gameboy.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="12dp"
                        android:text="🔁 Forçar rescan completo"
                        android:textSize="10sp" />

                    <!-- Assinatura air-gapped — só faz sentido numa carteira com
                         seed (assina PSBT de uma carteira watch-only pareada);
                         escondido em runtime pra carteira watch-only -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sign_airgapped_psbt"
                        style="@style/Gameboy.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="12dp"
                        android:text="🔏 Assinar PSBT (air-gapped)"
                        android:textSize="10sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="@color/gb_border_soft"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:id="@+id/tv_seed_backup_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔐  Backup da seed: Verificado ✓"
                        android:textSize="13sp"
                        android:textColor="@color/green_status"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="@color/gb_border_soft"
                        android:layout_marginVertical="12dp" />

                    <!-- Tema claro/escuro -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🖥 TEMA"
                        android:textSize="10sp"
                        style="@style/Gameboy.Label"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_theme_light"
                            style="@style/Gameboy.Button"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="☀ CLARO"
                            android:textSize="10sp"
                            app:backgroundTint="@color/accent_yellow" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_theme_dark"
                            style="@style/Gameboy.Button.Outline"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="🌙 ESCURO"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="@color/gb_border_soft"
                        android:layout_marginVertical="12dp" />

                    <!-- Node Electrum próprio -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌐 REDE"
                        android:textSize="10sp"
                        style="@style/Gameboy.Label"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tv_electrum_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/gb_border_soft"
                        android:layout_marginBottom="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_configure_electrum"
                        style="@style/Gameboy.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🌐 Configurar Node"
                        android:textSize="10sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="@color/gb_border_soft"
                        android:layout_marginVertical="12dp" />

                    <!-- Scan de recebimento Silent Payments (BIP-352, Fase 3) —
                         oracle (blindbit-oracle) configurável, mesmo padrão do
                         node Electrum acima. Só carteira com seed (watch-only
                         "somente scan" é fase futura). -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒 SILENT PAYMENTS"
                        android:textSize="10sp"
                        style="@style/Gameboy.Label"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tv_sp_oracle_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/gb_border_soft"
                        android:layout_marginBottom="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_configure_sp_oracle"
                        style="@style/Gameboy.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🔒 Configurar Oracle"
                        android:textSize="10sp"
                        android:layout_marginBottom="10dp" />

                    <!-- Confirmação de UTXOs SP via Tor (Orbot) — evita bloqueio de IP
                         do Blockstream/mempool.space (já bateu rate limit em campo
                         antes, ver BlockstreamClient.baseUrls). Desligado por padrão;
                         escopo restrito a esta confirmação, não afeta saldo/scan
                         normal do resto do app. Exige o Orbot já rodando quando
                         ligado (ver seção Tor abaixo). -->
                    <CheckBox
                        android:id="@+id/cb_sp_confirm_via_tor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🧅 Confirmar via Tor (evita bloqueio de IP)"
                        android:textSize="11sp"
                        android:textColor="@color/gb_border_soft"
                        android:layout_marginBottom="10dp" />

                    <CheckBox
                        android:id="@+id/cb_sp_electrum_fallback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌐 Fallback pra Electrum públicos (ativo por padrão, MAINNET)"
                        android:textSize="11sp"
                        android:textColor="@color/gb_border_soft"
                        android:layout_marginBottom="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sync_silent_payments"
                        style="@style/Gameboy.Button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🔄 Sincronizar agora"
                        android:textSize="10sp"
                        app:backgroundTint="@color/green_status" />

                    <!-- Rescan manual desde uma altura específica — "Sincronizar
                         agora" só cobre daqui pra frente (continua de
                         spScanTipHeight, ou olha só os últimos 100 blocos numa
                         carteira restaurada sem birthHeight conhecida). Pagamento
                         SP recebido ANTES dessa janela fica invisível pra sempre
                         sem isso — bug real encontrado numa restauração
                         (2026-09-04): a carteira restaurada nunca escaneou os
                         blocos onde os pagamentos de verdade foram minerados. -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Carteira restaurada? O scan normal olha só os últimos 100 blocos. Se o pagamento é mais antigo, informa a altura do bloco abaixo (dá pra ver no mempool.space/blockstream.info pesquisando o txid) e reescaneia a partir dali."
                        android:textSize="10sp"
                        android:textColor="@color/gb_border_soft"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Altura do bloco"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="10dp"
                        app:boxStrokeColor="@color/gb_border_soft"
                        app:hintTextColor="@color/gb_border_soft">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_sp_rescan_height"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/gb_border"
                            android:fontFamily="monospace"
                            android:singleLine="true" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sp_rescan_from_height"
                        style="@style/Gameboy.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🔄 Reescanear desde essa altura"
                        android:textSize="10sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="@color/gb_border_soft"
                        android:layout_marginVertical="12dp" />

                    <!-- Lightning via Breez SDK - Spark (self-custodial, BOLT11 +
                         endereço Spark + LN address) — feature opt-in, só conecta
                         quando o usuário toca "Ativar". Rede sem suporte (só
                         MAINNET/REGTEST) ou watch-only escondem o botão de ativar
                         e mostram só o aviso, ver WalletFragment.updateLightningUi. -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ LIGHTNING"
                        android:textSize="10sp"
                        style="@style/Gameboy.Label"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tv_lightning_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/gb_border_soft"
                        android:layout_marginBottom="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lightning_connect"
                        style="@style/Gameboy.Button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="⚡ Ativar Lightning"
                        android:textSize="10sp"
                        app:backgroundTint="@color/green_status"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:id="@+id/row_lightning_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="10dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_lightning_receive"
                                style="@style/Gameboy.Button.Outline"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:text="📥 Receber"
                                android:textSize="10sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_lightning_send"
                                style="@style/Gameboy.Button.Outline"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:text="📤 Enviar"
                                android:textSize="10sp" />

                        </LinearLayout>

                        <!-- Peg-in/peg-out — um toque transfere TODO o saldo
                             (não pede valor nem mostra endereço, pedido
                             explícito do Felipe); endereço on-chain usado
                             por baixo é sempre FIXO nos dois sentidos, ver
                             WalletFragment.showPegInConfirm/showPegOutConfirm. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_lightning_pegin"
                                style="@style/Gameboy.Button.Outline"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:text="⬇ Depositar tudo"
                                android:textSize="9sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_lightning_pegout"
                                style="@style/Gameboy.Button.Outline"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:text="⬆ Sacar tudo"
                                android:textSize="9sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="@color/gb_border_soft"
                        android:layout_marginVertical="12dp" />

                    <!-- Tor (Orbot) — usado só na hora de enviar (modo "Tor" no diálogo de envio) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧅 TOR (ORBOT)"
                        android:textSize="10sp"
                        style="@style/Gameboy.Label"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tv_tor_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/gb_border_soft"
                        android:layout_marginBottom="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_configure_tor"
                        style="@style/Gameboy.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🧅 Configurar Tor"
                        android:textSize="10sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="@color/gb_border_soft"
                        android:layout_marginVertical="12dp" />

                    <!-- Histórico de transações -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋 HISTÓRICO"
                        android:textSize="10sp"
                        style="@style/Gameboy.Label"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:id="@+id/layout_tx_history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="@color/gb_border_soft"
                        android:layout_marginVertical="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_forget"
                        style="@style/Gameboy.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠ Esquecer Wallet"
                        android:textSize="10sp"
                        android:textColor="@color/error_red" />

            </LinearLayout>

            <!-- Mensagem de erro -->
            <LinearLayout
                android:id="@+id/card_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                android:background="@drawable/bg_gameboy_box">

                <TextView
                    android:id="@+id/tv_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="13sp"
                    android:textColor="@color/error_red" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/gb_border" />

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gb_screen_alt"
        app:itemIconTint="@color/gb_border_soft"
        app:itemTextColor="@color/gb_border_soft"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/wallet_bottom_nav" />

</LinearLayout>
