<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gb_screen">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/gb_screen_alt"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ POKéWALLET"
            android:textSize="12sp"
            style="@style/Gameboy.Title"
            android:textColor="@color/primary_red" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/badge_network"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/circle_green" />

            <TextView
                android:id="@+id/tv_network_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="MAINNET"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/green_status" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/gb_border" />

    <!-- Conteúdo scrollável -->
    <ScrollView
        android:id="@+id/scroll_base"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card de saldo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_gameboy_box"
                android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SALDO"
                        android:textSize="10sp"
                        style="@style/Gameboy.Label" />

                    <TextView
                        android:id="@+id/tv_balance_sats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="— sat"
                        android:textSize="22sp"
                        android:textColor="@color/gb_border"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_balance_btc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="— BTC"
                        android:textSize="14sp"
                        android:textColor="@color/gb_border_soft"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tv_balance_pending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/bitcoin_orange"
                        android:layout_marginTop="6dp"
                        android:visibility="gone" />

                    <!-- Barra de progresso de scan -->
                    <ProgressBar
                        android:id="@+id/progress_scan"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="16dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/primary_red"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_scan_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="11sp"
                        android:textColor="@color/gb_border_soft"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_last_scan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="11sp"
                        android:textColor="@color/gb_border_soft"
                        android:visibility="gone" />

            </LinearLayout>

            <!-- Botões Receber / Enviar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_receive"
                    style="@style/Gameboy.Button"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="📥 Receber"
                    android:textSize="11sp"
                    app:backgroundTint="@color/green_status" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send"
                    style="@style/Gameboy.Button"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="💸 Enviar"
                    android:textSize="11sp"
                    app:backgroundTint="@color/bitcoin_orange" />

            </LinearLayout>

            <!-- Card Mochila -->
            <LinearLayout
                android:id="@+id/card_bag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                android:orientation="vertical"
                android:background="@drawable/bg_gameboy_box"
                android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎒 MOCHILA"
                        android:textSize="10sp"
                        style="@style/Gameboy.Label"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tv_wallet_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/gb_border_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="@color/gb_border_soft"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔐  Backup da seed: Verificado ✓"
                        android:textSize="13sp"
                        android:textColor="@color/green_status"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="@color/gb_border_soft"
                        android:layout_marginVertical="12dp" />

                    <!-- Tema claro/escuro -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🖥 TEMA"
                        android:textSize="10sp"
                        style="@style/Gameboy.Label"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_theme_light"
                            style="@style/Gameboy.Button"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="☀ CLARO"
                            android:textSize="10sp"
                            app:backgroundTint="@color/accent_yellow" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_theme_dark"
                            style="@style/Gameboy.Button.Outline"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="🌙 ESCURO"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="@color/gb_border_soft"
                        android:layout_marginVertical="12dp" />

                    <!-- Histórico de transações -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋 HISTÓRICO"
                        android:textSize="10sp"
                        style="@style/Gameboy.Label"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:id="@+id/layout_tx_history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="@color/gb_border_soft"
                        android:layout_marginVertical="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_forget"
                        style="@style/Gameboy.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠ Esquecer Wallet"
                        android:textSize="10sp"
                        android:textColor="@color/error_red" />

            </LinearLayout>

            <!-- Mensagem de erro -->
            <LinearLayout
                android:id="@+id/card_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                android:background="@drawable/bg_gameboy_box">

                <TextView
                    android:id="@+id/tv_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="13sp"
                    android:textColor="@color/error_red" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/gb_border" />

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gb_screen_alt"
        app:itemIconTint="@color/gb_border_soft"
        app:itemTextColor="@color/gb_border_soft"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/wallet_bottom_nav" />

</LinearLayout>
