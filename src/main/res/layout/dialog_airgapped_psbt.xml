<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overworld_repeat">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gameboy_box"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📡 ASSINE NO OUTRO APARELHO"
            android:textSize="13sp"
            style="@style/Gameboy.Title"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Escaneie esse QR no aparelho que guarda a seed (botão “🔏 Assinar PSBT”). Depois de assinar lá, toque em “Escanear tx assinada” abaixo pra trazer o resultado de volta."
            android:textSize="12sp"
            android:textColor="@color/gb_border_soft"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <ImageView
            android:id="@+id/img_qr_psbt"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginBottom="16dp"
            android:background="@android:color/white"
            android:padding="10dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_expected_txid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:textColor="@color/gb_border_soft"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Modo de transmissão da tx já assinada (depois de escaneada) —
             mesmas duas opções do envio normal, watch-only também pode
             escolher entre Internet direto ou BitChat/Nostr. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/send_mode_label"
                android:textSize="10sp"
                style="@style/Gameboy.Label"
                android:layout_marginBottom="10dp" />

            <RadioGroup
                android:id="@+id/rg_airgapped_broadcast_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/rb_airgapped_mode_internet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/send_mode_internet"
                    android:buttonTint="@color/bitcoin_orange"
                    android:textColor="@color/gb_border"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rb_airgapped_mode_bitchat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/send_mode_bitchat"
                    android:buttonTint="@color/bitcoin_orange"
                    android:textColor="@color/gb_border" />

            </RadioGroup>

            <TextView
                android:id="@+id/tv_airgapped_mode_explainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/send_mode_internet_explainer"
                android:textSize="12sp"
                android:textColor="@color/gb_border_soft" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scan_signed_tx"
            style="@style/Gameboy.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📷 Escanear TX assinada"
            android:textSize="12sp"
            app:backgroundTint="@color/bitcoin_orange"
            android:layout_marginBottom="12dp" />

        <ProgressBar
            android:id="@+id/progress_airgapped"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/accent_yellow"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_airgapped_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_airgapped"
            style="@style/Gameboy.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Fechar"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
