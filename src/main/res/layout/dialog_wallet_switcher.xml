<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gb_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gameboy_box"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 TROCAR CARTEIRA"
            android:textSize="13sp"
            style="@style/Gameboy.Title"
            android:layout_marginBottom="20dp" />

        <!-- Chips das carteiras conhecidas, populados dinamicamente em
             WalletFragment.showSwitchWalletDialog() -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_wallets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="24dp" />

        <!-- Botões -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_switch_wallet"
                style="@style/Gameboy.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Cancelar"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_switch_wallet"
                style="@style/Gameboy.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Trocar"
                android:textSize="12sp"
                app:backgroundTint="@color/accent_yellow" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
