<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overworld_repeat">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gameboy_box"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔑 CHAVE PÚBLICA"
            android:textSize="13sp"
            style="@style/Gameboy.Title"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sem risco em compartilhar — não dá acesso aos fundos, só permite ver saldo/endereços (importar como watch-only noutro aparelho, ou parear com um signer air-gapped)."
            android:textSize="12sp"
            android:textColor="@color/gb_border_soft"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- QR Code -->
        <ImageView
            android:id="@+id/img_qr_public_key"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginBottom="24dp"
            android:background="@android:color/white"
            android:padding="10dp"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ORIGEM DA CONTA (fingerprint + xpub)"
            android:textSize="10sp"
            style="@style/Gameboy.Label"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_account_origin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textIsSelectable="true"
            android:textColor="@color/accent_yellow"
            android:background="@color/bg_dark"
            android:padding="14dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy_account_origin"
            style="@style/Gameboy.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Copiar"
            android:textSize="12sp"
            app:backgroundTint="@color/green_status" />

    </LinearLayout>
</ScrollView>
