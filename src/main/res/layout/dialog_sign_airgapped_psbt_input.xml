<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overworld_repeat">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gameboy_box"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔏 ASSINAR PSBT"
            android:textSize="13sp"
            style="@style/Gameboy.Title"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Traga o PSBT não-assinado do aparelho watch-only — pode ser deste app ou de qualquer outra wallet compatível (ex.: BlueWallet, Sparrow), desde que a chave que assina seja a mesma desta carteira."
            android:textSize="12sp"
            android:textColor="@color/gb_border_soft"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scan_psbt_to_sign"
            style="@style/Gameboy.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📷 Escanear QR"
            android:textSize="12sp"
            app:backgroundTint="@color/bitcoin_orange"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_import_psbt_file"
            style="@style/Gameboy.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📁 Importar arquivo PSBT"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OU COLE O TEXTO DO PSBT (base64)"
            android:textSize="10sp"
            style="@style/Gameboy.Label"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="cHNidP8...(base64 do PSBT)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="8dp"
            app:boxStrokeColor="@color/gb_border_soft"
            app:hintTextColor="@color/gb_border_soft">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_psbt_to_sign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textNoSuggestions"
                android:textColor="@color/gb_border"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:minLines="3"
                android:gravity="top"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_sign_psbt_input_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/error_red"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_sign_psbt_input"
                style="@style/Gameboy.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Cancelar"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_psbt_to_sign"
                style="@style/Gameboy.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Confirmar texto"
                android:textSize="12sp"
                app:backgroundTint="@color/accent_yellow" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
