<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📥  Endereço de Recebimento"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="28dp" />

        <!-- QR Code -->
        <ImageView
            android:id="@+id/img_qr"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginBottom="28dp"
            android:background="@android:color/white"
            android:padding="14dp"
            android:scaleType="fitCenter" />

        <!-- Endereço -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ENDEREÇO"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:textColor="@color/accent_yellow"
            android:background="@color/bg_dark"
            android:padding="18dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_address_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy_address"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/copy"
            android:textStyle="bold"
            android:textColor="@color/bg_dark"
            app:backgroundTint="@color/green_status"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
