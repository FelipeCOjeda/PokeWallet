<?xml version="1.0" encoding="utf-8"?>
<!-- Botão "cheio" estilo Game Boy: cantos retos, borda preta grossa, sem
     sombra/gradiente. Cor de preenchimento definida por quem usa via
     app:backgroundTint (accent_yellow ou primary_red). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/accent_yellow" />
    <stroke android:width="3dp" android:color="@color/gb_border" />
</shape>
