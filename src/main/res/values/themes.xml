<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PokéWallet" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary_red</item>
        <item name="colorPrimaryDark">@color/primary_red_dark</item>
        <item name="colorAccent">@color/accent_yellow</item>
        <item name="colorError">@color/error_red</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/card_dark</item>
        <item name="android:navigationBarColor">@color/card_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="alertDialogTheme">@style/Theme.PokéWallet.Dialog</item>
    </style>

    <style name="Theme.PokéWallet.Dialog" parent="Theme.MaterialComponents.Dialog">
        <item name="colorPrimary">@color/primary_red</item>
        <item name="android:windowBackground">@color/card_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="CardStyle" parent="">
        <item name="android:background">@color/card_dark</item>
        <item name="android:padding">20dp</item>
    </style>
</resources>
